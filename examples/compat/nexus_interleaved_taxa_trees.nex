#NEXUS

BEGIN TAXA;
  DIMENSIONS NTAX=6;
  TAXLABELS alpha_ref alpha_syn alpha_mis beta_stop beta_fs beta_del;
END;

BEGIN CHARACTERS;
  DIMENSIONS NCHAR=111;
  FORMAT DATATYPE=DNA MISSING=? GAP=- INTERLEAVE=YES;
  MATRIX
[ interleaved blocks of 40 ]
    alpha_ref    ATGGCACTGAAAGAGTTCGGCATGCCGTACGACATCTGGA
    alpha_syn    ATGGCATTGAAAGAGTTCGGCATGCCGTACGACATCTGGA
    alpha_mis    ATGGAACTGAAAGAGTTCGGCATGCCGTACGACATCTGGA
    beta_stop    ATGGCACTGAAAGAGTTCGGCATGCCGTAAGACATCTGGA
    beta_fs      ATGG-ACTGAAAGAGTTCGGCATGCCGTACGACATCTGGA
    beta_del     ATGGCACTGAAAGAGTTC---ATGCCGTACGACATCTGGA

    alpha_ref    AGCAGGTGAGCTTTCGATAGAAAAAACCCCCCGATTACAT
    alpha_syn    AGCAGGTGAGCTTTCGATAGAAAAAACCCCCCGATTACAT
    alpha_mis    AGCAGGTGAGCTTTCGATAGAAAAAACCCCCCGATTACAT
    beta_stop    AGCAGGTGAGCTTTCGATAGGGGGGGTTTTTTGATTACAT
    beta_fs      AGCAGGTGAGCTTTCGATAGGGGGGGTTTTTTGATTACAT
    beta_del     AGCAGGTGAGCTTTCGATAGGGGGGGTTTTTTGATTACAT

    alpha_ref    TTGATTACATGTAATCGAATTCGGATCCCAA
    alpha_syn    TTGATTACATGTAATCGAATTCGGATCCCAA
    alpha_mis    TTGATTACATGTAATCGAATTCGGATCCCAA
    beta_stop    TTGATTACATGTAATCGAATTCGGATCCCAA
    beta_fs      TTGATTACATGTAATCGAATTCGGATCCCAA
    beta_del     TTGATTACATGTAATCGAATTCGGATCCCAA

  ;
END;

BEGIN TREES;
  TREE t1 = ((alpha_ref,alpha_syn),alpha_mis,(beta_stop,(beta_fs,beta_del)));
END;
